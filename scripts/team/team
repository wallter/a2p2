HERE = os.path.dirname(os.path.realpath(__file__))
SELF = os.path.realpath(__file__)
LABEL_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,31}$")
HARNESSES = ("claude", "codex", "agy", "command")
HARD_CAP = 16
REFUSAL_CODES = ("invalid_request", "not_found", "not_allowed", "not_shown",
                 "already_done", "not_registered", "too_large", "networking_off",
                 "not_caught_up", "rate_limited", "unavailable", "internal")
# Final states. "exited" is the supervisor's record of an exit that the
# observer has not classified yet.
FINAL = ("done", "failed", "not_ready", "limit", "stopped", "lost")
KILL_GRACE = 5.0
TICK = 0.1          # supervisor loop: deadlines, exits and stop requests
HEARTBEAT_STALE = 3.0
ACK_WAIT = 3.0

# Profiles that keep the harness's own permission and sandbox controls.
CLAUDE_MODES = ("", "default", "acceptEdits", "plan")
CODEX_SANDBOXES = ("read-only", "workspace-write")
CLAUDE_TOOLS_REFUSED = re.compile(r"^(\*|Bash|Bash\(\*\)|Bash\(:\*\))$|dangerous", re.I)
# One tool as Claude Code names it: a name, and for some tools one rule in
# parentheses. The names are joined with "," into one --allowedTools value,
# and Claude Code may also split that value at spaces, so "," anywhere and a
# space outside the parentheses would name another tool.
CLAUDE_TOOL_RE = re.compile(r"[A-Za-z][A-Za-z0-9_-]*(\([^(),]*\))?")
# Commands that run whatever their arguments say: allowing one by prefix
# allows every command. Not a complete list; see README.md.
CLAUDE_BASH_REFUSED = {
    "sh", "bash", "zsh", "dash", "ksh", "fish", "csh", "tcsh", "busybox", "env", "xargs", "exec", "eval",
    "command", "builtin", "nohup", "nice", "timeout", "time", "watch", "sudo", "su", "doas", "ssh",
    "python", "python2", "python3", "perl", "ruby", "node", "deno", "bun", "php", "lua", "osascript",
    "awk", "gawk", "find", "make", "npx", "uvx", "pipx", "script"}


def claude_tool_problem(t):
    """Why an allowed_tools entry would skip Claude Code's permission
    checks for more than one scoped tool, or None."""
    # The whole entry must match, and no character in it may be a control,
    # a format character or a space other than U+0020: Claude Code could
    # split at one, and a person reading the manifest would not see it.
    if CLAUDE_TOOLS_REFUSED.search(t.strip()) or not CLAUDE_TOOL_RE.fullmatch(t) or \
            any(c != " " and (c.isspace() or hidden(ord(c))) for c in t):
        return "is not one scoped tool"
    name, _, rule = t.partition("(")
    if name.lower() != "bash":
        return None
    rule = rule[:-1]
    # ":*" ends a prefix rule; anywhere else it is a wildcard like "*".
    rule = rule[:-2] if rule.endswith(":*") else rule
    words = rule.split()
    if not words:
        return "allows every command"
    # File names are compared without case: on the default macOS file
    # system /usr/bin/GIT is git.
    word = os.path.basename(words[0]).lower()
    if any(c in words[0] for c in WILDCARDS) or word in CLAUDE_BASH_REFUSED or re.fullmatch(r"python[0-9.]*", word):
        return f"allows {word} with any arguments, which runs any command"
    # A wildcard in the subcommand's place, as in "git *", is "git" alone.
    if word == "git" and (len(words) == 1 or words[1].startswith("-") or any(c in words[1] for c in WILDCARDS)):
        return "allows git with any options, and git -c runs any command"
    return None


WILDCARDS = "*?[]$`'\"\\;&|<>{}~=:"

TOP_KEYS = {"room", "a2p2_home", "a2p2", "state_dir", "max_members", "lead", "watcher_label",
            "kickoff", "prelude", "poll_seconds", "silence_seconds", "approve_a2p2_tools", "members"}
# The a2p2 MCP tools. A Claude Code member is allowed these by name, so a
# tool a later a2p2 adds is not allowed without a change here.
A2P2_TOOLS = ("whoami", "peers", "send", "inbox", "reply", "ack", "ask_human")
HEADLESS = ("claude", "codex", "agy")
MEMBER_KEYS = {"label", "harness", "model", "brief", "brief_file", "limit_seconds",
               "silence_seconds", "workdir", "worktree"}
HARNESS_KEYS = {"claude": {"permission_mode", "allowed_tools", "max_budget_usd"},
                "codex": {"sandbox"}, "agy": set(), "command": {"command", "mcp_harness"}}


class Fail(Exception):
    pass


# ---------------------------------------------------------------- manifest

def positive(v, what):
    """A finite number above zero; refuses booleans, strings, NaN and infinity."""
    if isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(v) or v <= 0:
        raise Fail(f"manifest: {what} must be a finite number above zero, not {v!r}")
    return float(v)


def load_manifest(path):
    path = os.path.abspath(path)
    try:
        with open(path) as f:
            m = json.load(f)
    except (OSError, ValueError) as e:
        raise Fail(f"cannot read manifest {path}: {e}")
    base = os.path.dirname(path)

    def p(v):
        return v if v is None else os.path.normpath(os.path.join(base, os.path.expanduser(v)))

    unknown = set(m) - TOP_KEYS
    if unknown:
        raise Fail(f"manifest: unknown keys {', '.join(sorted(unknown))}")
    for k in ("room", "a2p2_home", "members"):
        if k not in m:
            raise Fail(f"manifest: {k!r} is required")
    a2p2 = m.get("a2p2", "a2p2")
    if os.sep in a2p2 or a2p2.startswith("."):
        a2p2 = p(a2p2)
    else:
        import shutil
        a2p2 = shutil.which(a2p2) or a2p2
    stem = os.path.splitext(os.path.basename(path))[0]
    man = {
        "path": path,
        "room": m["room"],
        "home": p(m["a2p2_home"]),
        "a2p2": a2p2,
        "state": p(m.get("state_dir") or os.path.join(".team", stem)),
        "max_members": int(m.get("max_members", 4)),
        "lead": m.get("lead", "lead"),
        "watcher": m.get("watcher_label", "team"),
        "kickoff": m.get("kickoff", ""),
        "prelude": p(m["prelude"]) if m.get("prelude") else os.path.join(HERE, "prelude.md"),
        "poll": positive(m.get("poll_seconds", 5), "poll_seconds"),
        "silence": positive(m.get("silence_seconds", 300), "silence_seconds"),
        "members": [],
    }
    if not LABEL_RE.match(man["room"]):
        raise Fail("manifest: room must be a short lower-case label")
    if man["max_members"] > HARD_CAP:
        raise Fail(f"manifest: max_members is at most {HARD_CAP}")
    if len(m["members"]) > man["max_members"]:
        raise Fail(f"manifest: {len(m['members'])} members, more than max_members {man['max_members']}")
    seen = {man["lead"], man["watcher"], "human"}
    for i, mm in enumerate(m["members"]):
        label = mm.get("label", "")
        if not LABEL_RE.match(label):
            raise Fail(f"manifest: member {i}: label must match {LABEL_RE.pattern}")
        if label in seen:
            raise Fail(f"manifest: label {label!r} is used twice (or is the lead, watcher or human)")
        seen.add(label)
        h = mm.get("harness")
        if h not in HARNESSES:
            raise Fail(f"manifest: {label}: harness must be one of {', '.join(HARNESSES)}")
        unknown = set(mm) - MEMBER_KEYS - HARNESS_KEYS[h]
        if unknown:
            raise Fail(f"manifest: {label}: keys not used by {h}: {', '.join(sorted(unknown))}")
        if h != "command" and not mm.get("model"):
            raise Fail(f"manifest: {label}: model is required for {h}")
        if h == "command" and not (isinstance(mm.get("command"), list) and mm["command"]):
            raise Fail(f"manifest: {label}: command must be a list of arguments")
        if mm.get("workdir") and mm.get("worktree"):
            raise Fail(f"manifest: {label}: give workdir or worktree, not both")
        if h == "agy" and mm.get("workdir"):
            raise Fail(f"manifest: {label}: agy needs a directory the launcher creates (omit workdir)")
        mode = mm.get("permission_mode", "")
        if h == "claude" and mode not in CLAUDE_MODES:
            raise Fail(f"manifest: {label}: permission_mode {mode!r} is not allowed; "
                       f"use one of {', '.join(repr(x) for x in CLAUDE_MODES[1:])} (or omit it)")
        tools = mm.get("allowed_tools", [])
        if not isinstance(tools, list) or not all(isinstance(t, str) for t in tools):
            raise Fail(f"manifest: {label}: allowed_tools must be a list of tool names")
        bad = [f"{t!r} {why}" for t in tools for why in [claude_tool_problem(t)] if why]
        if bad:
            raise Fail(f"manifest: {label}: allowed_tools {'; '.join(bad)}: it would skip Claude Code's permission "
                       "checks; name one scoped tool per entry, such as Read or Bash(git status:*)")
        model = mm.get("model", "")
        if not isinstance(model, str) or model.startswith("-") or re.search(r"[\x00-\x1f\x7f]", model):
            raise Fail(f"manifest: {label}: model must be one line of text that does not start with '-', "
                       "so the harness cannot read it as an option")
        sandbox = mm.get("sandbox", "read-only")
        if h == "codex" and sandbox not in CODEX_SANDBOXES:
            raise Fail(f"manifest: {label}: sandbox {sandbox!r} is not allowed; use one of {', '.join(CODEX_SANDBOXES)}")
        budget = mm.get("max_budget_usd")
        if budget is not None:
            positive(budget, f"{label}: max_budget_usd")
        brief = mm.get("brief", "")
        if mm.get("brief_file"):
            with open(p(mm["brief_file"])) as f:
                brief = f.read()
        man["members"].append({
            "label": label,
            "harness": h,
            "model": mm.get("model", ""),
            "sandbox": sandbox,
            "permission_mode": mode,
            "allowed_tools": list(tools),
            "max_budget_usd": budget,
            "limit": positive(mm.get("limit_seconds", 900), f"{label}: limit_seconds"),
            "silence": positive(mm.get("silence_seconds", man["silence"]), f"{label}: silence_seconds"),
            "workdir": p(mm.get("workdir")),
            "worktree": p(mm.get("worktree")),
            "command": mm.get("command"),
            "mcp_harness": mm.get("mcp_harness", "command"),
            "brief": brief,
        })
    if not man["members"]:
        raise Fail("manifest: no members")
    approve = m.get("approve_a2p2_tools", False)
    if not isinstance(approve, bool):
        raise Fail("manifest: approve_a2p2_tools must be true or false")
    man["approve_a2p2_tools"] = approve
    return man


def require_tool_approval(man):
    """A member runs without a person to answer its prompts, so the
    launcher approves every a2p2 tool for it, send included. Text that
    anyone in a room of that home writes can then lead it to post without a
    prompt. The person says so in the manifest; nothing else turns it on.
    Only `up` asks: status, stop, logs and report work for any run, also
    one started from a manifest without the key."""
    headless = [x["label"] for x in man["members"] if x["harness"] in HEADLESS]
    if headless and not man["approve_a2p2_tools"]:
        raise Fail(f"manifest: {', '.join(headless)} run without a person to answer prompts, so the launcher must "
                   "approve their a2p2 tools, send, reply, ack and ask_human included: text anyone writes in a room "
                   "of a2p2_home can then lead them to post without a prompt. Set \"approve_a2p2_tools\": true to "
                   "accept that, and use a home whose rooms only this team shares")


def read_prelude(man):
    """Reads the prelude once, into the manifest: the prompts are checked
    and launched from this text, not from the file read again later."""
    try:
        with open(man["prelude"]) as f:
            man["prelude_text"] = f.read()
    except OSError as e:
        raise Fail(f"cannot read prelude {man['prelude']}: {e}")


def require_safe_prompt(m, prompt):
    """A harness's prompt is one argument of its command line; one that
    starts with '-' could be read as an option."""
    if m["harness"] in HEADLESS and prompt.lstrip().startswith("-"):
        raise Fail(f"manifest: {m['label']}: the prompt (prelude, then brief) starts with '-', "
                   "so the harness could read it as an option")


def require_safe_prompts(man):
    """Checked before anything starts, with the lead's id and a kickoff id
    in their places; launch_spec checks each prompt again as it is
    launched, with the real ones."""
    if "prelude_text" not in man:
        read_prelude(man)
    for m in man["members"]:
        require_safe_prompt(m, prompt_for(man, m, "kickoff", man["lead"] + "@node"))


# ------------------------------------------------------------------- a2p2

def a2p2(man, *args, check=True):
    env = dict(os.environ, A2P2_HOME=man["home"])
    r = subprocess.run([man["a2p2"], *args], env=env, stdin=subprocess.DEVNULL,
                       capture_output=True, text=True, timeout=60)
    if check and r.returncode != 0:
        raise Fail(f"a2p2 {args[0]} failed: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout


def a2p2_json(man, *args):
    return json.loads(a2p2(man, *args, "--json"))


def post(man, text):
    """An ordinary room message from the watcher label. Never peer text."""
    try:
        return a2p2(man, "send", "--as", man["watcher"], "--room", man["room"], "--", text).strip()
    except (Fail, subprocess.SubprocessError) as e:
        log(f"post failed: {e}")
        return ""


def history(man, since=None, page=200):
    """Room history oldest first; pages back until `since` (epoch) is passed."""
    out, before = [], None
    while True:
        args = ["history", "--room", man["room"], "-n", str(page)]
        if before:
            args.append("--before=" + before)
        try:
            ents = a2p2_json(man, *args).get("entries", [])
        except (Fail, ValueError, subprocess.SubprocessError):
            break
        out = ents + out
        if len(ents) < page or since is None or not ents or ts(ents[0]["created"]) < since:
            break
        before = ents[0]["id"]
    return out


def ts(iso_):
    return datetime.datetime.fromisoformat(iso_.replace("Z", "+00:00")).timestamp()


def iso(t):
    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ") if t else ""


def log(msg):
    print(f"{iso(time.time())} {msg}", flush=True)


# ------------------------------------------------------------------ state

def roster_path(man):
    return os.path.join(man["state"], "roster.json")


def load_roster(man):
    try:
        with open(roster_path(man)) as f:
            return json.load(f)
    except (OSError, ValueError):
        raise Fail(f"no run found in {man['state']}; start one with: team up")


def save_roster(man, r):
    replace_file(roster_path(man), json.dumps(r, indent=2))


def mdir(man, label):
    return os.path.join(man["state"], "members", label)


def control_dir(man):
    return os.path.join(man["state"], "control")


def supervisor_live(man):
    """True if the supervisor touched its heartbeat recently. Informational
    only: stop decisions go through the control handshake."""
    try:
        return time.time() - os.path.getmtime(os.path.join(man["state"], "heartbeat")) < HEARTBEAT_STALE
    except OSError:
        return False


def private_group(gid):
    """Whether only this user is in group gid: this user's primary group,
    with no other member and no other account that has it as primary
    group. Many Linux systems give each user such a group and the umask
    002, so the user's own directories are 0775; a group-writable one is
    then as private as 0755. On macOS the primary group (staff) is shared
    and this is False. Accounts that pwd cannot list, such as some
    directory services give, are not seen."""
    if gid != os.getgid():
        return False
    try:
        me = pwd.getpwuid(os.getuid()).pw_name
        if any(u != me for u in grp.getgrgid(gid).gr_mem):
            return False
        return not any(e.pw_gid == gid and e.pw_uid != os.getuid() for e in pwd.getpwall())
    except (KeyError, OSError):
        return False


def others_may_write(st):
    """Whether a user other than this one or root may write the entry:
    others have the write bit, or the group does and is not this user's
    private group."""
    if st.st_mode & 0o002:
        return True
    return bool(st.st_mode & 0o020) and not private_group(st.st_gid)


def shared_path_problem(path):
    """Why another user of this machine could replace `path` or a directory
    on the way to it, or None. Every directory passed through, symlinks
    followed, must belong to this user or root, and one that group or
    others may write must have the sticky bit (a group that is only this
    user does not count, see private_group); in such a directory the
    entry passed through must belong to this user or root, so that nobody
    else can rename it. The part of the path that does not exist yet is
    created by the launcher in the last directory checked."""
    uid = os.getuid()
    todo = [c for c in os.path.abspath(path).split(os.sep) if c]
    cur, hops = os.sep, 0
    cst = os.stat(cur)
    while todo:
        name = todo.pop(0)
        if name == ".":
            continue
        if name == "..":
            cur = os.path.dirname(cur)
            cst = os.stat(cur)
            continue
        nxt = os.path.join(cur, name)
        try:
            st = os.lstat(nxt)
        except FileNotFoundError:
            return None
        if others_may_write(cst) and st.st_uid not in (uid, 0):
            return f"{nxt} belongs to another user (uid {st.st_uid}) in {cur}, which others may write"
        if stat.S_ISLNK(st.st_mode):
            hops += 1
            if hops > 40:
                return f"{path} has too many symlinks"
            target = os.readlink(nxt)
            if os.path.isabs(target):
                cur, cst = os.sep, os.stat(os.sep)
            todo = [c for c in target.split(os.sep) if c] + todo
            continue
        if not stat.S_ISDIR(st.st_mode):
            return f"{nxt} is not a directory"
        if st.st_uid not in (uid, 0):
            return f"{nxt} belongs to another user (uid {st.st_uid}), who could replace what is in it"
        if others_may_write(st) and not st.st_mode & stat.S_ISVTX:
            how, fix = (" through its group", "g-w") if not st.st_mode & 0o002 else ("", "o-w")
            return (f"{nxt} can be changed by other users{how} (mode {stat.S_IMODE(st.st_mode):o}), "
                    f"who could replace what is in it (if it is yours, chmod {fix} it)")
        cur, cst = nxt, st
    return None


def require_private_path(path, what):
    why = shared_path_problem(path)
    if why:
        raise Fail(f"{what} {path}: {why}; choose a directory only you can change")


def require_private_state(state):
    """The state directory of a run: on a path no other user can change,
    and, if it exists, a directory of this user that group and others
    cannot write. Every command checks it before it reads or writes there,
    the supervisor before it runs the command lines saved there."""
    require_private_path(state, "state_dir")
    try:
        st = os.lstat(state)
    except FileNotFoundError:
        return
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        raise Fail(f"{state} is not a directory of this user; set another state_dir")
    if others_may_write(st):
        raise Fail(f"{state} can be changed by other users (mode {stat.S_IMODE(st.st_mode):o}); "
                   "remove it or set another state_dir")


def make_private_dirs(path):
    """Creates path and each missing directory above it with mode 0700,
    whatever the umask: os.makedirs gives the directories above the last
    the umask's mode, 0775 under the umask 002 of many Linux systems,
    which require_private_path would then refuse. A directory that exists
    is left as it is; the caller checks the path again afterwards."""
    missing = []
    p = os.path.abspath(path)
    while not os.path.lexists(p):
        missing.append(p)
        p = os.path.dirname(p)
    for d in reversed(missing):
        try:
            os.mkdir(d, 0o700)
        except FileExistsError:
            continue
        os.chmod(d, 0o700)


def create_new(path, text):
    """Write a file that must not exist yet; refuses existing files and symlinks."""
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    except FileExistsError:
        raise Fail(f"{path} already exists (or is a symlink); the launcher will not overwrite it")
    with os.fdopen(fd, "w") as f:
        f.write(text)


def replace_file(path, text):
    """Write path through a new file renamed over it, so a symlink planted
    at path is replaced, never written through."""
    tmp = f"{path}.{os.getpid()}.{uuid.uuid4().hex[:8]}.tmp"
    create_new(tmp, text)
    os.replace(tmp, path)


# ----------------------------------------------------------------- launch

def prompt_for(man, m, kickoff_id, lead_id):
    prelude = man["prelude_text"]
    for k, v in (("{label}", m["label"]), ("{room}", man["room"]),
                 ("{lead}", lead_id), ("{kickoff}", kickoff_id)):
        prelude = prelude.replace(k, v)
    return prelude + m["brief"].strip() + "\n"


def prepare_dirs(man, m):
    """Creates the member's directory, working directory and per-run
    configuration files, before anything else happens. Returns the
    working directory."""
    d = mdir(man, m["label"])
    os.makedirs(d)
    if m["workdir"]:
        work = m["workdir"]
        if not os.path.isdir(work):
            raise Fail(f"{m['label']}: workdir {work} is not a directory")
    elif m["worktree"]:
        work = os.path.join(d, "work")
        r = subprocess.run(["git", "-C", m["worktree"], "worktree", "add", "--detach", work, "HEAD"],
                           capture_output=True, text=True)
        if r.returncode != 0:
            raise Fail(f"{m['label']}: git worktree add failed: {r.stderr.strip()}")
    else:
        work = os.path.join(d, "work")
        os.makedirs(work)
    label, home, exe = m["label"], man["home"], man["a2p2"]
    if m["harness"] == "claude":
        create_new(os.path.join(d, "mcp.json"), json.dumps(
            {"mcpServers": {"a2p2": {"command": exe, "args": ["mcp", "--harness", "claude", "--name", label],
                                     "env": {"A2P2_HOME": home}}}}))
    elif m["harness"] == "agy":
        agents = os.path.join(work, ".agents")
        if os.path.islink(agents):
            raise Fail(f"{m['label']}: {agents} is a symlink; the launcher will not write through it")
        os.makedirs(agents, exist_ok=True)
        create_new(os.path.join(agents, "mcp_config.json"), json.dumps(
            {"mcpServers": {"a2p2": {"command": exe, "args": ["mcp", "--harness", "agy", "--name", label],
                                     "env": {"A2P2_HOME": home}}}}))
    return work


def launch_spec(man, m, prompt, work):
    """The member's command line and environment additions."""
    require_safe_prompt(m, prompt)
    d = mdir(man, m["label"])
    create_new(os.path.join(d, "prompt.md"), prompt)
    final = os.path.join(d, "final.txt")
    label, home, exe = m["label"], man["home"], man["a2p2"]
    env = {"A2P2_HOME": home}
    h = m["harness"]
    if h == "claude":
        argv = ["claude", "-p", prompt, "--model", m["model"], "--no-session-persistence",
                "--mcp-config", os.path.join(d, "mcp.json"), "--strict-mcp-config",
                "--allowedTools", ",".join(["mcp__a2p2__" + t for t in A2P2_TOOLS] + m["allowed_tools"]),
                "--output-format", "stream-json", "--verbose"]
        if m["permission_mode"]:
            argv += ["--permission-mode", m["permission_mode"]]
        if m["max_budget_usd"] is not None:
            argv += ["--max-budget-usd", str(m["max_budget_usd"])]
    elif h == "codex":
        argv = ["codex", "exec", prompt, "-m", m["model"], "-s", m["sandbox"], "--ephemeral",
                "--skip-git-repo-check", "-C", work,
                "-c", "mcp_servers.a2p2.command=" + json.dumps(exe),
                "-c", "mcp_servers.a2p2.args=" + json.dumps(["mcp", "--harness", "codex", "--name", label]),
                "-c", "mcp_servers.a2p2.env={A2P2_HOME=" + json.dumps(home) + "}",
                "-c", 'mcp_servers.a2p2.default_tools_approval_mode="approve"',
                "--json", "-o", final]
    elif h == "agy":
        argv = ["agy", "--settings", json.dumps({"permissions": {"allow": ["mcp(a2p2/*)"]}}),
                "--model", m["model"], "--print-timeout", f"{int(m['limit'])}s", "-p=" + prompt]
    else:
        # A custom command is trusted input: the person who writes the
        # manifest vouches for it, as for any program they run.
        vals = {"a2p2": exe, "home": home, "label": label, "room": man["room"], "workdir": work,
                "final": final, "prompt_file": os.path.join(d, "prompt.md"), "team_dir": HERE}
        argv = [str(a).format(**vals) for a in m["command"]]
        env.update(A2P2_BIN=exe, TEAM_LABEL=label, TEAM_ROOM=man["room"], TEAM_FINAL=final,
                   TEAM_PROMPT_FILE=vals["prompt_file"], TEAM_MCP_HARNESS=m["mcp_harness"])
    # The consent `up` checked goes with the command line, so the
    # supervisor starts a member with approved tools only if it was given.
    spec = {"argv": argv, "cwd": work, "env": env, "approve_a2p2_tools": man["approve_a2p2_tools"]}
    create_new(os.path.join(d, "launch.json"), json.dumps(spec))
    return final


def server_harness(m):
    return m["mcp_harness"] if m["harness"] == "command" else m["harness"]


# -------------------------------------------------------------------- up

def reserve(man):
    """Claims the state directory for one run; a second `up` is refused.
    The directory is this user's alone: the supervisor runs the command
    lines saved in it, and no other user may be able to replace it, a
    directory above it or anything in it. One that group or others could
    write is refused, not repaired: they may have planted files in it."""
    require_private_state(man["state"])
    make_private_dirs(man["state"])
    require_private_state(man["state"])
    os.chmod(man["state"], 0o700)
    try:
        os.close(os.open(os.path.join(man["state"], "reserved"), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600))
    except FileExistsError:
        raise Fail(f"{man['state']} already holds a run; remove it or set another state_dir")


SNAPSHOT = "manifest.json"


def load_snapshot(state):
    """The manifest as `up` checked it, saved in the state directory: the
    supervisor runs from it, not from the manifest file, which may have
    changed since, a2p2 binary included."""
    state = os.path.abspath(state)
    require_private_state(state)
    try:
        with open(os.path.join(state, SNAPSHOT)) as f:
            man = json.load(f)
    except (OSError, ValueError) as e:
        raise Fail(f"no run found in {state}: {e}")
    if man.get("state") != state:
        raise Fail(f"{state}/{SNAPSHOT} belongs to the run in {man.get('state')!r}")
    return man


def cmd_up(man, args):
    require_tool_approval(man)
    read_prelude(man)
    require_safe_prompts(man)
    # The home holds the node's key and the socket members' tool servers
    # use; one that another user could swap is refused before anything.
    require_private_path(man["home"], "a2p2_home")
    reserve(man)
    create_new(os.path.join(man["state"], SNAPSHOT), json.dumps(man, indent=2))
    os.makedirs(os.path.join(man["state"], "members"))
    os.makedirs(control_dir(man))
    works = {m["label"]: prepare_dirs(man, m) for m in man["members"]}
    if not os.path.isdir(man["home"]):
        make_private_dirs(man["home"])
    # Checked again just before the first a2p2 call starts a daemon there:
    # a directory missing at the first check could have been made by
    # another user since, and the daemon checks only the home itself.
    require_private_path(man["home"], "a2p2_home")
    st = a2p2_json(man, "status")
    node8 = st["node"][:8]
    if man["room"] not in [r["label"] for r in st.get("rooms", [])]:
        a2p2(man, "room", "create", man["room"])
    # An agent sees only room posts made after it registered, so register
    # every label (and the watcher) before the kickoff is posted.
    for label in [m["label"] for m in man["members"]] + [man["watcher"]]:
        a2p2(man, "inbox", "--as", label, "--room", man["room"], "--peek", "--json")
    lead_id = f"{man['lead']}@{node8}"
    roster_line = ", ".join(f"{m['label']} ({m['harness']})" for m in man["members"])
    kickoff = man["kickoff"] or "Kickoff. Each member has its own brief."
    kickoff += (f"\n\nMembers: {roster_line}. Lead: {lead_id}. Reply to this message with your plan, "
                "and later with your DONE: or BLOCKED: report.")
    # "--" ends the flags: a kickoff that starts with '-' is text, not an option.
    kickoff_id = a2p2(man, "send", "--as", man["lead"], "--room", man["room"], "--", kickoff).strip()
    roster = {"room": man["room"], "home": man["home"], "node8": node8, "lead": lead_id,
              "watcher": f"{man['watcher']}@{node8}", "kickoff": kickoff_id, "started": time.time(),
              "ended": None, "manifest": man["path"], "supervisor_pid": None, "members": []}
    for m in man["members"]:
        final = launch_spec(man, m, prompt_for(man, m, kickoff_id, lead_id), works[m["label"]])
        d = mdir(man, m["label"])
        roster["members"].append({
            "label": m["label"], "id": f"{m['label']}@{node8}", "harness": m["harness"],
            "server_harness": server_harness(m), "model": m["model"], "limit": m["limit"],
            "silence": m["silence"], "workdir": works[m["label"]], "out": os.path.join(d, "out.log"),
            "err": os.path.join(d, "err.log"), "final": final, "pid": None, "state": "pending",
            "launched": None, "connected": None, "ended": None, "wall_clock": None, "exit": None,
            "limit_hit": False, "stop_requested": None, "note": ""})
    save_roster(man, roster)
    with open(os.path.join(man["state"], "supervisor.log"), "a") as wl:
        w = subprocess.Popen([sys.executable, SELF, "_supervise", man["state"]],
                             stdin=subprocess.DEVNULL, stdout=wl, stderr=subprocess.STDOUT,
                             start_new_session=True)
    deadline = time.time() + 30
    while time.time() < deadline:
        r = load_roster(man)
        if all(x["pid"] or x["state"] in FINAL for x in r["members"]) or w.poll() is not None:
            break
        time.sleep(0.1)
    print(f"kickoff {kickoff_id} in room {man['room']}; state in {man['state']}")
    cmd_status(man, args)
    if args.wait:
        w.wait()
        cmd_report(man, args)


# ----------------------------------------------------------------- guard

def cmd_guard(argv):
    """Leads the member's process group. Runs the member; if the pipe from
    the supervisor closes (the supervisor died), ends the whole group.
    Exits with the member's status (128 + signal if it was killed)."""
    child = subprocess.Popen(argv, stdin=subprocess.DEVNULL)
    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, signal.SIG_IGN)  # the member gets group signals itself
    orphaned_at = None
    while True:
        code = child.poll()
        if code is not None:
            return code if code >= 0 else 128 - code
        if orphaned_at is None:
            r, _, _ = select.select([0], [], [], 0.2)
            if r and not os.read(0, 1):
                orphaned_at = time.monotonic()
                os.killpg(0, signal.SIGTERM)
        else:
            if time.monotonic() - orphaned_at > KILL_GRACE:
                os.killpg(0, signal.SIGKILL)
            time.sleep(0.1)


# ------------------------------------------------------------- supervisor

class Supervisor:
    """Owns the member processes. Its loop never calls a2p2 and never waits
    on the room, so deadlines and stop requests are handled within a tick.
    Room observation and posting run in a separate thread."""

    def __init__(self, man):
        self.man = man
        self.roster = load_roster(man)
        self.lock = threading.Lock()
        self.procs = {}           # label -> Popen of the guard, while not reaped
        self.deadline = {}        # label -> monotonic limit deadline
        self.started = {}         # label -> monotonic launch time
        self.kill_at = {}         # label -> monotonic time to send SIGKILL
        self.posts = queue.Queue()
        self.shutdown = None      # the signal that asked the supervisor to end
        self.done = threading.Event()

    def save(self):
        with self.lock:
            save_roster(self.man, self.roster)

    def member(self, label):
        return next(x for x in self.roster["members"] if x["label"] == label)

    def heartbeat(self):
        hb = os.path.join(self.man["state"], "heartbeat")
        try:
            os.utime(hb)
        except FileNotFoundError:
            open(hb, "w").close()

    def launch(self, x):
        with open(os.path.join(mdir(self.man, x["label"]), "launch.json")) as f:
            spec = json.load(f)
        if x["harness"] in HEADLESS and spec.get("approve_a2p2_tools") is not True:
            with self.lock:
                x.update(state="failed", launched=time.time(), ended=time.time(), note="its saved command line approves a2p2's tools, "
                         "and the run was started without \"approve_a2p2_tools\": true")
            self.posts.put(f"failed: {x['label']} was not started: a2p2's tools were not approved for it.")
            self.save()
            return
        env = dict(os.environ, **spec["env"])
        launched = time.time()     # taken before the process exists
        t0 = time.monotonic()
        try:
            with open(x["out"], "w") as out, open(x["err"], "w") as err:
                p = subprocess.Popen([sys.executable, SELF, "_guard", "--", *spec["argv"]], cwd=spec["cwd"],
                                     env=env, stdin=subprocess.PIPE, stdout=out, stderr=err,
                                     start_new_session=True)
        except OSError as e:
            with self.lock:
                x.update(state="failed", launched=launched, ended=time.time(), note=f"could not start: {e}")
            self.posts.put(f"failed: {x['label']} could not start ({x['harness']}: {e.strerror or e}).")
            self.save()
            return
        self.procs[x["label"]] = p
        self.started[x["label"]] = t0
        self.deadline[x["label"]] = t0 + x["limit"]
        with self.lock:
            x.update(pid=p.pid, state="launched", launched=launched)
        self.save()  # each launch is published as it happens
        log(f"launched {x['label']} guard pid {p.pid}")

    def signal_group(self, label, sig):
        """Only for a guard this supervisor started and has not reaped, so
        its pid is still reserved as the group id."""
        p = self.procs.get(label)
        if p is None or p.returncode is not None:
            return
        try:
            os.killpg(p.pid, sig)
        except (ProcessLookupError, PermissionError):
            pass

    def terminate(self, label, why):
        x = self.member(label)
        if label in self.kill_at or label not in self.procs:
            return False
        with self.lock:
            if why == "limit":
                x.update(limit_hit=True, state="stopping")
            else:
                x.update(stop_requested=why, state="stopping")
        self.signal_group(label, signal.SIGTERM)
        self.kill_at[label] = time.monotonic() + KILL_GRACE
        return True

    def reap(self, label):
        """Called when the guard has exited but is not reaped yet: ends what
        is left of its group while the group id is still reserved."""
        p = self.procs[label]
        self.signal_group(label, signal.SIGKILL)
        code = p.wait()
        del self.procs[label]
        self.kill_at.pop(label, None)
        x = self.member(label)
        with self.lock:
            x.update(state="exited", exit=code, ended=time.time(),
                     wall_clock=round(time.monotonic() - self.started[label], 1))
        self.save()
        log(f"{label} exited {code}")

    def exited(self, label):
        p = self.procs[label]
        try:
            r = os.waitid(os.P_PID, p.pid, os.WEXITED | os.WNOHANG | os.WNOWAIT)
        except ChildProcessError:
            return True
        return r is not None and r.si_pid == p.pid

    def control(self):
        d = control_dir(self.man)
        for name in sorted(os.listdir(d)):
            if not (name.startswith("req-") and name.endswith(".json")):
                continue
            path = os.path.join(d, name)
            try:
                with open(path) as f:
                    req = json.load(f)
                os.remove(path)
            except (OSError, ValueError):
                continue
            label = req.get("stop")
            hit = [lb for lb in list(self.procs) if (label is None or lb == label) and self.terminate(lb, "team stop")]
            ack = os.path.join(d, "ack-" + name[4:])
            with open(ack + ".tmp", "w") as f:
                json.dump({"stopping": hit}, f)
            os.replace(ack + ".tmp", ack)

    def on_signal(self, signum, _frame):
        self.shutdown = signum

    def run(self):
        for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(s, self.on_signal)
        with self.lock:
            self.roster["supervisor_pid"] = os.getpid()
        self.heartbeat()
        observer = threading.Thread(target=Observer(self).run, daemon=True)
        observer.start()
        try:
            for x in self.roster["members"]:
                if self.shutdown is None:
                    self.launch(x)
            while self.procs:
                self.heartbeat()
                if self.shutdown is not None:
                    for label in list(self.procs):
                        self.terminate(label, "supervisor ended")
                self.control()
                now = time.monotonic()
                for label in list(self.procs):
                    if self.exited(label):
                        self.reap(label)
                    elif label in self.kill_at:
                        if now >= self.kill_at[label]:
                            self.signal_group(label, signal.SIGKILL)
                    elif now >= self.deadline[label]:
                        x = self.member(label)
                        self.terminate(label, "limit")
                        self.posts.put(f"limit: {label} passed its {x['limit']:.0f}s wall-clock limit "
                                       "and was stopped.")
                time.sleep(TICK)
        finally:
            # On any failure, leave no member behind.
            for label in list(self.procs):
                self.signal_group(label, signal.SIGKILL)
                code = self.procs[label].wait()
                x = self.member(label)
                with self.lock:
                    x.update(state="exited", exit=code, ended=time.time(), stop_requested="supervisor failed",
                             wall_clock=round(time.monotonic() - self.started[label], 1))
                del self.procs[label]
            for x in self.roster["members"]:
                if x["state"] == "pending":
                    with self.lock:
                        x.update(state="lost", note="never launched")
            self.save()
            self.done.set()
        observer.join()
        # The report calls a2p2, so it is written before the run is marked
        # ended: whoever sees "ended" can rely on the supervisor making no
        # further a2p2 call (a call would start a stopped daemon again).
        ended = time.time()
        try:
            write_report(self.man, ended=ended)
        finally:
            with self.lock:
                self.roster["ended"] = ended
            self.save()
        log("all members finished")


class Observer:
    """Reads the room and posts the watcher's messages. Slow or blocked a2p2
    calls here never delay the supervisor's deadlines."""

    def __init__(self, sup):
        self.sup = sup
        self.man = sup.man
        self.silent = set()
        self.asked = set()

    def flush(self):
        while True:
            try:
                text = self.sup.posts.get_nowait()
            except queue.Empty:
                return
            post(self.man, text)

    def run(self):
        next_poll = 0.0
        while True:
            finishing = self.sup.done.is_set()
            self.flush()
            if finishing or time.monotonic() >= next_poll:
                self.poll(final=finishing)
                next_poll = time.monotonic() + self.man["poll"]
            self.flush()
            if finishing:
                return
            self.sup.done.wait(0.2)

    def ready(self, agents, x):
        """The member's own MCP server registered its label: the harness's
        name, this run's working directory, and a last-seen time at or after
        the launch time taken before the process started. A CLI call under
        the label keeps an earlier harness name and directory, so a label
        reused from another run or directory does not count."""
        for a in agents:
            if a.get("id") != x["id"] or a.get("harness") != x["server_harness"] or not a.get("last_seen"):
                continue
            if not a.get("cwd") or os.path.realpath(a["cwd"]) != os.path.realpath(x["workdir"]):
                continue
            if ts(a["last_seen"]) >= x["launched"]:
                return True
        return False

    def poll(self, final=False):
        sup = self.sup
        # Only exits that happened before the agents were read are
        # classified, so a registration just before the exit is not missed.
        exited = {x["label"] for x in sup.roster["members"] if x["state"] == "exited"}
        try:
            agents = a2p2_json(self.man, "status").get("agents", [])
        except (Fail, ValueError, subprocess.SubprocessError):
            agents = []
        hist = history(self.man)
        now = time.time()
        for x in sup.roster["members"]:
            if x["state"] in FINAL or not x["launched"]:
                continue
            if not x["connected"] and self.ready(agents, x):
                with sup.lock:
                    x["connected"] = now
                    if x["state"] == "launched":
                        x["state"] = "running"
                post(self.man, f"started: {x['label']} ({x['harness']}{', ' + x['model'] if x['model'] else ''}); "
                               f"its a2p2 tool server connected as {x['id']} within {now - x['launched']:.0f}s.")
            mine = [e for e in hist if e.get("from") == x["id"] and ts(e["created"]) >= x["launched"]]
            for e in mine:
                if e["id"] not in self.asked and any(t.startswith("human@") for t in e.get("to") or []):
                    self.asked.add(e["id"])
                    post(self.man, f"needs input: {x['label']} asked the person a question (message {e['id']}).")
            if x["label"] in exited:
                self.classify(x)
                continue
            if x["state"] == "exited":
                continue
            if x["state"] in ("launched", "running"):
                last = max([ts(e["created"]) for e in mine] + [x["connected"] or x["launched"]])
                if now - last > x["silence"]:
                    if x["label"] not in self.silent:
                        self.silent.add(x["label"])
                        post(self.man, f"silent: {x['label']} has posted nothing in the room for {now - last:.0f}s.")
                else:
                    self.silent.discard(x["label"])
        sup.save()

    def classify(self, x):
        if x["harness"] == "claude":
            extract_claude_final(x)
        where = x["final"] if os.path.exists(x["final"]) and os.path.getsize(x["final"]) else x["out"]
        el, code, label = x["wall_clock"], x["exit"], x["label"]
        never = "" if x["connected"] else " Its a2p2 tool server never connected."
        if x["limit_hit"]:
            state, text = "limit", None
        elif x["stop_requested"] == "team stop":
            state, text = "stopped", f"stopped: {label} by team stop after {el:.0f}s (exit {code})."
        elif x["stop_requested"]:
            state, text = "stopped", f"stopped: {label} because the {x['stop_requested']} after {el:.0f}s (exit {code})."
        elif not x["connected"]:
            state, text = "not_ready", (f"not ready: {label} exited {code} after {el:.0f}s and its a2p2 tool "
                                        f"server never connected; output saved at {where}.")
        elif code == 0:
            state, text = "done", f"done: {label} exited 0 after {el:.0f}s; final answer saved at {where}."
        else:
            state, text = "failed", f"failed: {label} exited {code} after {el:.0f}s; output saved at {where}."
        with self.sup.lock:
            x.update(state=state, note=never.strip())
        if text:
            post(self.man, text)
        log(f"{label}: {state}")


def extract_claude_final(x):
    """Claude Code's stream-json output ends with a result event; save its text."""
    try:
        res = None
        with open(x["out"]) as f:
            for line in f:
                line = line.strip()
                if line.startswith("{") and '"type":"result"' in line.replace(" ", ""):
                    try:
                        res = json.loads(line).get("result")
                    except ValueError:
                        pass
        if res is not None:
            with open(x["final"], "w") as f:
                f.write(res)
    except OSError:
        pass


def cmd_supervise(args):
    # The supervisor runs the command lines saved in the state directory,
    # so load_snapshot checks again that no other user could have replaced
    # them, before it reads anything there.
    Supervisor(load_snapshot(args.state)).run()


# ------------------------------------------------------------ status/stop

def ago(t):
    if not t:
        return "-"
    s = int(time.time() - t)
    return f"{s}s" if s < 120 else f"{s // 60}m"


# Display escaping, as the daemon does it (decision D58, PROTOCOL 10.8):
# a port of escapeText in internal/node/escape.go, with the same tables and
# the same text rules, as internal/web/static/app.js is. The launcher is
# Python with no dependency and cannot call the Go helper. A test checks
# that these tables equal the daemon's and that both give the output of
# every row of internal/node/testdata/escape_cases.json.
HIDDEN = (
    (0x0000, 0x001f), (0x007f, 0x009f), (0x00ad, 0x00ad), (0x034f, 0x034f), (0x0600, 0x0605),
    (0x061c, 0x061c), (0x06dd, 0x06dd), (0x070f, 0x070f), (0x0890, 0x0891), (0x08e2, 0x08e2),
    (0x115f, 0x1160), (0x17b4, 0x17b5), (0x180b, 0x180f), (0x200b, 0x200f), (0x2028, 0x202e),
    (0x2060, 0x206f), (0x3164, 0x3164), (0xd800, 0xdfff), (0xfe00, 0xfe0f), (0xfeff, 0xfeff),
    (0xffa0, 0xffa0), (0xfff0, 0xfffb), (0x110bd, 0x110bd), (0x110cd, 0x110cd), (0x13430, 0x1343f),
    (0x1bca0, 0x1bca3), (0x1d173, 0x1d17a), (0xe0000, 0xe0fff))
EMOJI = (
