    (0x1f000, 0x1faff))
JOINING = ((0x0600, 0x08ff), (0x0900, 0x0dff), (0x1000, 0x109f), (0x1780, 0x18af),
           (0xfb50, 0xfdff), (0xfe70, 0xfefe))
RTL_LETTERS = (
    (0x05d0, 0x05ea), (0x05ef, 0x05f2), (0x0620, 0x064a), (0x066e, 0x066f), (0x0671, 0x06d3),
    (0x06d5, 0x06d5), (0x06ee, 0x06ef), (0x06fa, 0x06fc), (0x06ff, 0x06ff), (0x0710, 0x0710),
    (0x0712, 0x072f), (0x074d, 0x07a5), (0x07b1, 0x07b1), (0x07ca, 0x07ea), (0x0800, 0x0815),
    (0x0840, 0x0858), (0x0860, 0x086a), (0x0870, 0x0887), (0x0889, 0x088e), (0x08a0, 0x08c9),
    (0xfb1d, 0xfb1d), (0xfb1f, 0xfb28), (0xfb2a, 0xfb36), (0xfb38, 0xfb3c), (0xfb3e, 0xfb3e),
    (0xfb40, 0xfb41), (0xfb43, 0xfb44), (0xfb46, 0xfbb1), (0xfbd3, 0xfd3d), (0xfd50, 0xfd8f),
    (0xfd92, 0xfdc7), (0xfdf0, 0xfdfb), (0xfe70, 0xfe74), (0xfe76, 0xfefc))
SPACELESS = ((0x0e00, 0x0fff), (0x1000, 0x109f), (0x1780, 0x17ff))
HAN = ((0x3400, 0x4dbf), (0x4e00, 0x9fff), (0xf900, 0xfaff), (0x20000, 0x3ffff))
FLAG_TAGS = tuple("".join(chr(0xe0000 + ord(c)) for c in s) + "\U000e007f" for s in ("gbeng", "gbsct", "gbwls"))
CLS_EMOJI, CLS_SELECTOR, CLS_JOINING, CLS_KEYCAP, CLS_RTL, CLS_SPACELESS, CLS_HAN = (1 << i for i in range(7))


def in_ranges(tab, o):
    i = bisect.bisect_right(tab, (o, 0x10ffff))
    return i > 0 and tab[i - 1][0] <= o <= tab[i - 1][1]


def hidden(o):
    """Whether code point o is in the daemon's table (Hidden)."""
    return in_ranges(HIDDEN, o)


def text_class(o):
    if hidden(o):
        return 0
    c = CLS_KEYCAP if 0x30 <= o <= 0x39 or o in (0x23, 0x2a) else 0
    for tab, bit in ((EMOJI, CLS_EMOJI), (JOINING, CLS_JOINING), (RTL_LETTERS, CLS_RTL),
                     (SPACELESS, CLS_SPACELESS), (HAN, CLS_HAN)):
        if in_ranges(tab, o):
            c |= bit
    return c


def escape(s, lines=False):
    """Text a member wrote, or a line of a harness log, as the terminal
    should show it: EscapeDisplay of the daemon, or with lines
    EscapeDisplayText. Every character of the table is written \\u{hex}
    unless the text rules keep it (a joiner between two emoji or two
    letters of a script that needs it, and the others of escape.go), a
    byte that is not UTF-8 (read with surrogateescape) is written \\x{hh},
    and a backslash before "u{" or "x{" is written \\u{5c}. With lines, a
    newline and a tab stay and a carriage return straight before a
    newline is shown as that line break; any other carriage return is
    escaped."""
    out, prev, i, n = [], 0, 0, len(s)
    while i < n:
        c = s[i]
        o = ord(c)
        if o == 0x1f3f4:
            tail = next((t for t in FLAG_TAGS if s.startswith(t, i + 1)), "")
            if tail:
                out.append(c + tail)
                prev, i = CLS_EMOJI, i + 1 + len(tail)
                continue
        if lines and c == "\r" and s.startswith("\n", i + 1):
            out.append("\n")
            prev, i = 0, i + 2
            continue
        byte = 0xdc80 <= o <= 0xdcff
        hide, nxt = hidden(o), 0
        nc = text_class(ord(s[i + 1])) if i + 1 < n else 0
        if byte:
            pass
        elif c in "\n\t":
            hide = not lines
        elif c == "\\" and (s.startswith("u{", i + 1) or s.startswith("x{", i + 1)):
            hide = True
        elif (o == 0x200d and prev & (CLS_EMOJI | CLS_SELECTOR) and nc & CLS_EMOJI) or \
                (o in (0x200c, 0x200d) and prev & CLS_JOINING and nc & CLS_JOINING) or \
                (o in (0x200f, 0x061c) and prev & CLS_RTL and nc & CLS_RTL) or \
                (o == 0x200b and prev & CLS_SPACELESS and nc & CLS_SPACELESS) or \
                (0xe0100 <= o <= 0xe01ef and prev & CLS_HAN):
            hide = False
        elif o in (0xfe0e, 0xfe0f) and prev & CLS_EMOJI:
            hide, nxt = False, CLS_SELECTOR
        elif o in (0xfe0e, 0xfe0f) and prev & CLS_KEYCAP:
            hide = False
        elif not hide:
            nxt = text_class(o)
        if byte:
            out.append(f"\\x{{{o - 0xdc00:02x}}}")
        elif hide:
            out.append(f"\\u{{{o:x}}}")
        else:
            out.append(c)
        prev = nxt
        i += 1
    return "".join(out)


def clean(s, n):
    """One line of a member's text for the status table: each line break
    and tab as one space, cut to n characters, then escaped. Nothing else
    is dropped: a control at either end is escaped like any other."""
    s = re.sub(r"(?:\r?\n|\t)+", " ", s or "").strip(" ")
    return escape(s if len(s) <= n else s[: n - 1] + "~")


def cmd_status(man, _args):
    r = load_roster(man)
    hist = history(man)
    rows = [("LABEL", "HARNESS", "PID", "STATE", "LAST ROOM MESSAGE", "ELAPSED")]
    for x in r["members"]:
        mine = [e for e in hist if e.get("from") == x["id"]]
        last = f"{ago(ts(mine[-1]['created']))} ago: {clean(mine[-1].get('text'), 40)}" if mine else "-"
        el = x["wall_clock"] if x.get("wall_clock") is not None else \
            (time.time() - x["launched"] if x["launched"] else 0)
        state = x["state"] + (f" ({x['exit']})" if x["exit"] is not None else "")
        rows.append((x["label"], x["harness"], str(x["pid"] or "-"), state, last, f"{el:.0f}s"))
    w = [max(len(row[i]) for row in rows) for i in range(5)]
    for row in rows:
        print("  ".join(c.ljust(w[i]) for i, c in enumerate(row[:5])) + "  " + row[5])
    if not r.get("ended") and not supervisor_live(man):
        print("note: the supervisor is not running; states may be stale")


def cmd_stop(man, args):
    """Asks the live supervisor to stop members. Signals nothing itself."""
    r = load_roster(man)
    if args.label and not any(x["label"] == args.label for x in r["members"]):
        raise Fail(f"no member {args.label!r}")
    if r.get("ended"):
        print("the run has already ended")
        return
    nonce = uuid.uuid4().hex
    d = control_dir(man)
    req = os.path.join(d, f"req-{nonce}.json")
    with open(req + ".tmp", "w") as f:
        json.dump({"stop": args.label}, f)
    os.replace(req + ".tmp", req)
    ack = os.path.join(d, f"ack-{nonce}.json")
    deadline = time.monotonic() + ACK_WAIT
    while time.monotonic() < deadline and not os.path.exists(ack):
        time.sleep(0.05)
    if not os.path.exists(ack):
        try:
            os.remove(req)
        except OSError:
            pass
        r = load_roster(man)
        for x in r["members"]:
            if x["state"] not in FINAL:
                x.update(state="lost", note="the supervisor was not running; nothing was signalled")
        r["ended"] = time.time()
        save_roster(man, r)
        print("the run is not live: no supervisor answered. Nothing was signalled; "
              "the roster is marked ended. Check for leftover processes yourself.")
        return
    with open(ack) as f:
        hit = json.load(f)["stopping"]
    os.remove(ack)
    end = time.monotonic() + KILL_GRACE + 5
    while time.monotonic() < end:
        r = load_roster(man)
        if all(x["state"] in FINAL for x in r["members"] if x["label"] in hit):
            break
        time.sleep(0.1)
    print(f"stopped {len(hit)} member(s)" + (f": {', '.join(hit)}" if hit else ""))


def cmd_logs(man, args):
    r = load_roster(man)
    x = next((x for x in r["members"] if x["label"] == args.label), None)
    if not x:
        raise Fail(f"no member {args.label!r}")
    for name in ("out", "err"):
        print(f"==> {escape(x[name])} <==", flush=True)
        # A log holds a harness's raw output, which can quote what peers
        # wrote: it is escaped unless --raw asks for the bytes. It is read
        # line by line, or for -n from its end, never whole.
        try:
            with open(x[name], "rb") as f:
                for ln in (tail_lines(f, args.n) if args.n else f):
                    out = ln if args.raw else escape(ln.decode("utf-8", "surrogateescape"), lines=True).encode()
                    sys.stdout.buffer.write(out)
        except OSError:
            pass
        sys.stdout.buffer.flush()


def tail_lines(f, n, block=65536):
    """The last n lines of the binary file f, each ending with its "\\n"
    (the last may have none), read from the end in blocks. Only "\\n" ends
    a line, so a lone carriage return stays in its line and is escaped."""
    f.seek(0, os.SEEK_END)
    pos, buf = f.tell(), b""
    while pos > 0 and buf.count(b"\n") <= n:
        step = min(block, pos)
        pos -= step
        f.seek(pos)
        buf = f.read(step) + buf
    parts = buf.split(b"\n")
    lines = [p + b"\n" for p in parts[:-1]] + ([parts[-1]] if parts[-1] else [])
    return lines[-n:]


# ----------------------------------------------------------------- report

CODE_RE = re.compile(r'\\*"code\\*"\s*:\s*\\*"(' + "|".join(REFUSAL_CODES) + r')\\*"\s*,\s*\\*"retryable')
EMPTY_RE = re.compile(r'\\*"messages\\*"\s*:\s*\[\]')


def scan_logs(x):
    text = ""
    for name in ("out", "err"):
        try:
            with open(x[name], errors="replace") as f:
                text += f.read()
        except OSError:
            pass
    codes = {}
    for c in CODE_RE.findall(text):
        codes[c] = codes.get(c, 0) + 1
    return codes, len(EMPTY_RE.findall(text))


def build_report(man, ended=None):
    r = load_roster(man)
    r["ended"] = r["ended"] or ended
    hist = [e for e in history(man, since=r["started"]) if ts(e["created"]) >= r["started"] - 1]
    msgs = [e for e in hist if e.get("kind", "message") == "message"]
    member_ids = {x["id"] for x in r["members"]}
    others = len(member_ids) + 1  # members and the lead; the watcher only posts
    members = []
    for x in r["members"]:
        mine = [e for e in msgs if e.get("from") == x["id"]]
        multi = [e for e in mine if e.get("parent") and
                 (len([t for t in (e.get("to") or []) if t != x["id"]]) > 1 or (not e.get("to") and others - 1 > 1))]
        finals = [e for e in mine if re.match(r"\s*(DONE|BLOCKED):", e.get("text") or "")]
        codes, empty = scan_logs(x)
        members.append({
            "label": x["label"], "id": x["id"], "harness": x["harness"], "model": x["model"],
            "state": x["state"], "exit": x["exit"],
            "wall_clock_s": x["wall_clock"] if x.get("wall_clock") is not None else
            (round(time.time() - x["launched"], 1) if x["launched"] else None),
            "connected_within_s": round(x["connected"] - x["launched"], 1) if x["connected"] else None,
            "messages_sent": len(mine),
            "replies_to_more_than_one_inbox": len(multi),
            "questions_to_person": len([e for e in mine if any(t.startswith("human@") for t in e.get("to") or [])]),
            "refusals_by_code": codes,
            "empty_inbox_polls_in_logs": empty,
            "final_report": (finals[-1]["text"].strip().split(":", 1)[0] if finals else None),
            "final_answer_file": x["final"] if os.path.exists(x["final"]) else None,
        })
    try:
        waiting = sum(rm.get("waiting", 0) for rm in a2p2_json(man, "status").get("rooms", []))
    except (Fail, ValueError, subprocess.SubprocessError):
        waiting = None
    return {
        "room": r["room"], "kickoff": r["kickoff"], "lead": r["lead"],
        "started": iso(r["started"]), "ended": iso(r["ended"]),
        "wall_clock_s": round((r["ended"] or time.time()) - r["started"], 1),
        "members": members,
        "messages_in_room": len(msgs),
        "messages_from_person": len([e for e in msgs if (e.get("from") or "").startswith("human@")]),
        "messages_from_lead": len([e for e in msgs if e.get("from") == r["lead"]]),
        "watcher_messages": len([e for e in msgs if e.get("from") == r["watcher"]]),
        "person_requests_waiting": waiting,
        "notes": "Refusals and empty inbox polls are counted from the harness logs and are only as "
                 "complete as those logs. Room-wide replies count as reaching more than one inbox "
                 "when the team has more than two agents. Connection is seen within one poll.",
    }


def markdown(rep):
    out = [f"Room `{rep['room']}`, {rep['started']} to {rep['ended'] or 'running'}, "
           f"{rep['wall_clock_s']:.0f}s, {len(rep['members'])} members, {rep['messages_in_room']} messages "
           f"({rep['watcher_messages']} from the watcher, {rep['messages_from_lead']} from the lead, "
           f"{rep['messages_from_person']} from the person); person requests waiting: {rep['person_requests_waiting']}.", "",
           "| Member | Harness | Model | State (exit) | Wall-clock | Connected within | Sent | Multi-inbox replies | Questions to person | Refusals | Empty polls | Report |",
           "|---|---|---|---|---|---|---|---|---|---|---|---|"]
    for m in rep["members"]:
        refusals = ", ".join(f"{k} {v}" for k, v in sorted(m["refusals_by_code"].items())) or "0"
        conn = f"{m['connected_within_s']}s" if m["connected_within_s"] is not None else "never"
        out.append(f"| {m['label']} | {m['harness']} | {m['model'] or '-'} | {m['state']} ({m['exit']}) | "
                   f"{m['wall_clock_s']}s | {conn} | {m['messages_sent']} | "
                   f"{m['replies_to_more_than_one_inbox']} | {m['questions_to_person']} | {refusals} | "
                   f"{m['empty_inbox_polls_in_logs']} | {m['final_report'] or '-'} |")
    return "\n".join(out) + "\n"


def write_report(man, ended=None):
    rep = build_report(man, ended)
    replace_file(os.path.join(man["state"], "report.json"), json.dumps(rep, indent=2))
    md = markdown(rep)
    replace_file(os.path.join(man["state"], "report.md"), md)
    return md


def cmd_report(man, _args):
    sys.stdout.write(write_report(man))
    print(f"\nwritten: {os.path.join(man['state'], 'report.json')} and report.md")


# ------------------------------------------------------------------- main

def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv[:2] == ["_guard", "--"]:
        return cmd_guard(argv[2:])
    ap = argparse.ArgumentParser(prog="team", description="Launch and supervise a team of harnesses on an a2p2 room.")
    ap.add_argument("-m", "--manifest", default=os.environ.get("TEAM_MANIFEST", "team.json"))
    sub = ap.add_subparsers(dest="cmd", required=True)
    up = sub.add_parser("up", help="start every member and the supervisor")
    up.add_argument("--wait", action="store_true", help="wait until every member has finished, then report")
    sub.add_parser("status", help="list the roster")
    st = sub.add_parser("stop", help="ask the supervisor to end one member, or all")
    st.add_argument("label", nargs="?")
    lg = sub.add_parser("logs", help="print a member's output and error logs")
    lg.add_argument("label")
    lg.add_argument("-n", type=int, default=0, help="only the last N lines of each")
    lg.add_argument("--raw", action="store_true", help="print the bytes as written, controls included")
    sub.add_parser("report", help="measure the run: report.json and report.md")
    sv = sub.add_parser("_supervise")
    sv.add_argument("state")
    args = ap.parse_args(argv)
    try:
        if args.cmd == "_supervise":
            cmd_supervise(args)
            return 0
        man = load_manifest(args.manifest)
        if args.cmd != "up":
            # The run's files are read and written only where no other user
            # could have replaced them; `up` checks in reserve.
            require_private_state(man["state"])
        {"up": cmd_up, "status": cmd_status, "stop": cmd_stop, "logs": cmd_logs,
         "report": cmd_report}[args.cmd](man, args)
    except Fail as e:
        print(f"team: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
