          "type": "string"
        },
        "room": {
          "description": "room label or id; default local",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "to": {
          "description": "agent ids, or [\"everyone\"] (room-wide)",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
